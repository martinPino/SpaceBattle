{
  // Tablón de salas públicas de Space Battle.
  //   npx wrangler login --use-keyring   (una vez, abre el navegador)
  //   npx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "space-battle-rooms",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomRegistry" }]
  },
  // `storage: sqlite` es obligatorio en el plan gratuito. Este bloque declarativo
  // sustituye al array `migrations` de los tutoriales antiguos, y son excluyentes.
  // El namespace lo crea Cloudflare en el primer deploy: no hay comando que dar.
  "exports": {
    "RoomRegistry": { "type": "durable-object", "storage": "sqlite" }
  }
}
